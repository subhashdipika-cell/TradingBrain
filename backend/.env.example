# -------------------------------------------------------------------
# TradingBrain
# Application Configuration (template - copy to .env and fill secrets)
# -------------------------------------------------------------------

APP_NAME=TradingBrain
APP_VERSION=0.1.0
ENVIRONMENT=development

# -------------------------------------------------------------------
# API
# Backend runs on port 8200; frontend (Vite) runs on port 5174.
# -------------------------------------------------------------------

API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8200

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------

LOG_LEVEL=INFO

# -------------------------------------------------------------------
# CORS
# JSON arrays are supported by pydantic-settings.
# Frontend dev server origin (Vite) on port 5174.
# -------------------------------------------------------------------

CORS_ALLOW_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# -------------------------------------------------------------------
# Broker - Dhan (live data + execution)
# Used by app/domains/execution/adapters/dhan_adapter.py (requires `pip
# install dhanhq`). Leave blank for backtest/paper-on-historical runs.
# -------------------------------------------------------------------

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tradingbrain
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_ECHO=false
